{
  "name": "gogigi",
  "version": "0.1.5",
  "description": "GoGiGi — Electron desktop app with GitHub-based auto-update",
  "main": "src/main.js",
  "author": "GoGiGi",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/shadow-artlap/GoGiGi.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@puppeteer/browsers": "^2.10.2",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "puppeteer-core": "^23.11.1",
    "socks-proxy-agent": "^8.0.5"
  }
}
